# omc-to-gemini-porter — local environment configuration
#
# Copy this file to `.env` and edit the values for your machine.
# `.env` is gitignored — each user / machine keeps its own copy.

# =============================================================================
# IDE config directory  (REQUIRED to adapt for vendor forks)
# =============================================================================
# Where your Gemini CLI-based IDE reads user-level config from.
#
# Common values:
#   ~/.gemini                stock Gemini CLI
#   ~/.<vendor-folder>       a Gemini CLI-derived IDE (replace with the
#                            actual folder name your IDE uses)
#
# Inspect the user-config directory your IDE actually writes to (skills/,
# agents/, settings.json should already exist there) and set this to match.
OUT_TARGET=~/.gemini

# =============================================================================
# Session matching  (recommended: keep enabled until you know your IDE)
# =============================================================================
# When set to 1, the porter shim passes an empty session_id to OMC, which
# falls back to legacy session matching (state files that omit session_id).
#
# Leave enabled for first-time setup. Disable only when you've learned your
# IDE's session-ID convention and want full multi-session isolation.
OMC_PORTER_FORCE_LEGACY_SESSION=1

# =============================================================================
# OMC install path  (optional; auto-detected from npm if blank)
# =============================================================================
# Override the OMC install location. Useful if you have multiple OMC versions
# or installed OMC outside the npm global prefix.
#
# Defaults to: $(npm root -g)/oh-my-claude-sisyphus
# OMC_ROOT=

# =============================================================================
# Porter root  (optional; defaults to this repo's directory)
# =============================================================================
# Where the shim files live. apply.cjs uses this to rewrite the absolute
# shim paths inside settings.json so the IDE can locate them at runtime.
# OMC_PORTER_ROOT=
